# ============================================================================
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，绝不入库。
# ============================================================================

# --- 运行环境 ---
NODE_ENV=development
# 个人数据库根目录（Markdown 源）
PA_MEMORY_DIR=./memory
# SQLite 派生索引路径
PA_INDEX_DB=./data/index.sqlite

# --- smail 邮箱（P2 使用）---
# 南大邮箱：IMAP/SMTP 通常需在网页端开启客户端服务并获取授权码
PA_IMAP_HOST=
PA_IMAP_PORT=993
PA_SMTP_HOST=
PA_SMTP_PORT=465
PA_MAIL_USER=
PA_MAIL_PASS=

# --- 通道（P3 使用，二选一或都留空）---
PA_EMAIL_CHANNEL=
PA_TELEGRAM_BOT_TOKEN=

# --- 模型/推理（如需）---
PA_LLM_BASE_URL=
PA_LLM_API_KEY=
